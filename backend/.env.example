APP_ENV=development
# Local backend: use localhost and the published PostgreSQL port.
# Percent-encode reserved characters in database credentials.
DATABASE_URL=postgresql+psycopg://agipreve:replace_with_a_local_password@localhost:5432/agipreve
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Fictitious demo accounts only. Replace in local .env; never use a personal password.
DEMO_PASSWORD=demo-local-only-2026
SESSION_TTL_MINUTES=60
